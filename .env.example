# Borsa API kimlik bilgileri (trade-only izinli, çekim KAPALI olmalı)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_api_secret_here
# Yalnızca OKX gibi passphrase isteyen borsalarda doldurun
EXCHANGE_PASSWORD=

# Telegram bildirimleri (opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Canlı işlem güvenlik kapıları — gerçek emir göndermek için ikisini de ayarlayın
# Varsayılan: paper/backtest modunda kalmak için boş/NO bırakın
LIVE_TRADING_CONFIRM=NO
LIVE_RUNTIME_CONFIRM=

# Postgres (docker-compose dışında çalıştırıyorsanız)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investor_db

# Trading paneli (python -m crypto_bot.web)
# Ayarlıysa kontroller (pozisyon kapat, kill switch) bu token'ı ister.
# Ayarlı değilse kontroller yalnızca localhost'tan çalışır (Docker'da bu yüzden gerekli).
DASHBOARD_TOKEN=
